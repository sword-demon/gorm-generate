{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/sword-demon/*" }]
    }
  ]
}
